{
  "name": "service-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc",
    "check": "biome ci",
    "fix": "biome check --write",
    "test": "node --test 'test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
